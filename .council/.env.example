# Council Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and will not be committed.

# API Key (required for CLI operations)
# Obtain from the web UI: Settings > API Keys
COUNCIL_API_KEY=

# Web Server URL (optional, defaults to http://localhost:8015)
# COUNCIL_WEB_URL=http://localhost:8015

# Database (required for parent councils, optional for downstream)
# Downstream councils inherit from parent via ws_proxy
AGENTKIT_DATABASE__URL=postgresql://user:password@localhost:5432/council

# LLM Provider (optional, defaults to oss)
# AGENTKIT_LLM__PROVIDER=openai
# AGENTKIT_LLM__OPENAI__API_KEY=sk-...

# Hook authentication (optional)
# COUNCIL_HOOK_SECRET=your-secret-here
