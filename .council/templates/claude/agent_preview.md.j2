{# ================================================================= #}
{# AGENT PREVIEW TEMPLATE                                            #}
{# Minimal template for live preview - shows ONLY what user added    #}
{# Does NOT include Council tools, Scribe protocol, or other shared  #}
{# content that would be added to the final agent card.              #}
{# ================================================================= #}

---
name: {{ agent.name }}
{% if agent.get('description') -%}
description: "{{ agent.description | replace('"', '\\"') }}"
{% endif -%}
model: {{ agent.get('model', 'sonnet') }}
council_role: {{ agent.get('council_role', 'specialist') }}
{% if agent.get('domains') -%}
domains: [{{ agent.get('domains', []) | map('tojson') | join(', ') }}]
{% endif -%}
---

{# ================================================================= #}
{# PERSONA IDENTITY                                                   #}
{# ================================================================= #}

{% if agent.get('display_name') or agent.get('name') -%}
You are **{{ agent.get('display_name', agent.name) | title }}**{% if agent.get('title') %}, {{ agent.title }}{% endif %}.
{% endif %}

{% if agent.get('identity_prompt') -%}

{{ agent.get('identity_prompt') }}
{% endif %}

{# ================================================================= #}
{# EXPERTISE                                                          #}
{# ================================================================= #}

{% if agent.get('expertise_prompt') -%}

---

## Your Expertise

{{ agent.get('expertise_prompt') }}
{% endif %}

{# ================================================================= #}
{# BEHAVIORAL GUIDELINES                                              #}
{# ================================================================= #}

{% if agent.get('behavioral_guidelines') -%}

---

## Behavioral Guidelines

{{ agent.get('behavioral_guidelines') }}
{% endif %}

{# ================================================================= #}
{# TOOL GUIDANCE                                                      #}
{# ================================================================= #}

{% if agent.get('tool_guidance') -%}

---

## Tool Usage

{{ agent.get('tool_guidance') }}
{% endif %}

{# ================================================================= #}
{# CUSTOM SECTIONS                                                    #}
{# ================================================================= #}

{% set custom_sections = agent.get('_custom_sections_list', []) %}
{% if custom_sections -%}
{% for section in custom_sections %}

---

{% if section.title %}## {{ section.title }}
{% endif %}

{{ section.content }}
{% endfor %}
{% endif %}

{# ================================================================= #}
{# PREVIEW NOTE - Dynamic based on enabled bundles                    #}
{# ================================================================= #}

{% set bundles = agent.get('protocol_bundles', {}) %}
{% set bundle_defaults = agent.get('_bundle_defaults', {}) %}
{% set template_options = agent.get('template_options', {}) %}
{% set include_council_membership = template_options.get('include_council_membership', true) %}
{% set include_council_protocol = template_options.get('include_council_protocol', true) %}
{% set enabled_bundles = [] %}
{% if bundles.get('council_tools', {}).get('enabled', bundle_defaults.get('council_tools', true)) %}{% set _ = enabled_bundles.append('Council MCP Tools') %}{% endif %}
{% if bundles.get('scribe_protocol', {}).get('enabled', bundle_defaults.get('scribe_protocol', true)) %}{% set _ = enabled_bundles.append('Scribe Protocol') %}{% endif %}
{% if bundles.get('session_protocol', {}).get('enabled', bundle_defaults.get('session_protocol', false)) %}{% set _ = enabled_bundles.append('Session Protocol') %}{% endif %}
{% if bundles.get('agentkit_patterns', {}).get('enabled', bundle_defaults.get('agentkit_patterns', false)) %}{% set _ = enabled_bundles.append('AgentKit Patterns') %}{% endif %}
{% if bundles.get('dual_logging', {}).get('enabled', bundle_defaults.get('dual_logging', false)) %}{% set _ = enabled_bundles.append('Dual Logging') %}{% endif %}
{% if bundles.get('persona_embodiment', {}).get('enabled', bundle_defaults.get('persona_embodiment', false)) %}{% set _ = enabled_bundles.append('Persona Embodiment') %}{% endif %}

---

> **Preview Note**: The final agent card will include:
{% if include_council_membership %}
> - Council Membership section
{% endif %}
{% if include_council_membership and include_council_protocol %}
> - Council Protocol (session management, memory, collaboration)
{% endif %}
{% if enabled_bundles %}
> - Enabled protocol bundles: {{ enabled_bundles | join(', ') }}
{% else %}
> - No protocol bundles enabled
{% endif %}
