---
name: {{ agent.name }}
description: "{{ agent.description | replace('"', '\\"') }}"
{% if agent.get('tools') -%}
allowedTools:
{% for tool in agent.tools %}  - {{ tool }}
{% endfor -%}
{% endif -%}
{% if agent.get('disallowed_tools') -%}
disallowedTools:
{% for tool in agent.disallowed_tools %}  - {{ tool }}
{% endfor -%}
{% endif -%}
model: {{ agent.get('model', 'sonnet') }}
{% if agent.get('permission_mode') -%}
permissionMode: {{ agent.permission_mode }}
{% endif -%}
{% if agent.get('skills') -%}
skills: [{{ agent.skills | map('tojson') | join(', ') }}]
{% endif -%}
{% if agent.get('color') -%}
color: "{{ agent.color }}"
{% endif -%}
# ═══════════════════════════════════════════════════════════════
# COUNCIL-SPECIFIC FRONTMATTER (stored in persona metadata)
# ═══════════════════════════════════════════════════════════════
council_role: {{ agent.get('council_role', 'specialist') }}
agent_type: {{ agent.get('agent_type', 'claude_code') }}
domains: [{{ agent.get('domains', []) | map('tojson') | join(', ') }}]
{% if agent.get('can_delegate') is not none -%}
can_delegate: {{ agent.can_delegate | string | lower }}
{% endif -%}
{% if agent.get('llm_provider') -%}
llm_provider: {{ agent.llm_provider }}
{% endif -%}
{% if agent.get('memory_config') -%}
memory_visibility: {{ agent.memory_config.get('visibility', 'private') }}
memory_strength: {{ agent.memory_config.get('default_strength', 0.5) }}
{% endif -%}
---

