---
nav_label: Control Center
nav_order: 1
nav_group: Snapshot Ops
nav_group_order: 1
nav_group_icon: monitor
---
{% extends "base.html" %}

{% block title %}Control Center - OSRS{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="/council-static/css/osrs-pages.css">
{% endblock %}

{% block content %}
<div class="osrs-page" id="osrs-control-root">

  {# =========================================================================
     1. RUNTIME CONTROLS -- top of page, prominent
     ========================================================================= #}
  <div class="osrs-card osrs-runtime">
    <div class="osrs-card__header">
      <h2 class="osrs-card__header-title">Backend Runtime</h2>
      <span class="osrs-badge osrs-badge--info" id="runtime-status-badge">Unknown</span>
    </div>
    <div class="osrs-card__body">
      <div class="osrs-runtime__status">
        <div class="osrs-stat-row">
          <span class="osrs-stat-row__label">Status</span>
          <span class="osrs-stat-row__value" id="runtime-status">--</span>
        </div>
        <div class="osrs-stat-row">
          <span class="osrs-stat-row__label">PID</span>
          <span class="osrs-stat-row__value" id="runtime-pid">--</span>
        </div>
        <div class="osrs-stat-row">
          <span class="osrs-stat-row__label">Port</span>
          <span class="osrs-stat-row__value" id="runtime-port">--</span>
        </div>
        <div class="osrs-stat-row">
          <span class="osrs-stat-row__label">Uptime</span>
          <span class="osrs-stat-row__value" id="runtime-uptime">--</span>
        </div>
      </div>
      <div class="osrs-runtime__actions">
        <button class="btn btn-primary" id="btn-start" type="button">Start</button>
        <button class="btn btn-danger" id="btn-stop" type="button">Stop</button>
        <button class="btn btn-secondary" id="btn-refresh" type="button">Refresh</button>
      </div>
    </div>
  </div>

  {# =========================================================================
     2. HEALTH STATS -- KPI grid
     ========================================================================= #}
  <div class="osrs-card">
    <div class="osrs-card__header">
      <h3 class="osrs-card__header-title">Health Overview</h3>
      <span class="osrs-badge osrs-badge--info" id="health-status-badge">--</span>
    </div>
    <div class="osrs-card__body">
      <div class="osrs-kpi-grid" id="kpi-grid">
        <div class="osrs-kpi">
          <div class="osrs-kpi__value" id="kpi-accounts">--</div>
          <div class="osrs-kpi__label">Tracked Accounts</div>
        </div>
        <div class="osrs-kpi">
          <div class="osrs-kpi__value" id="kpi-snapshots">--</div>
          <div class="osrs-kpi__label">Total Snapshots</div>
        </div>
        <div class="osrs-kpi">
          <div class="osrs-kpi__value" id="kpi-schema">--</div>
          <div class="osrs-kpi__label">Schema Version</div>
        </div>
        <div class="osrs-kpi">
          <div class="osrs-kpi__value" id="kpi-last-check">--</div>
          <div class="osrs-kpi__label">Last Health Check</div>
        </div>
      </div>
    </div>
  </div>

  {# =========================================================================
     3. QUICK SNAPSHOT -- inline form
     ========================================================================= #}
  <div class="osrs-card">
    <div class="osrs-card__header">
      <h3 class="osrs-card__header-title">Quick Snapshot</h3>
    </div>
    <div class="osrs-card__body">
      <form class="osrs-snapshot-form" id="quick-snapshot-form">
        <div class="osrs-snapshot-form__field osrs-snapshot-form__field--grow">
          <label class="osrs-snapshot-form__label" for="snapshot-player">Player Name</label>
          <input type="text"
                 class="osrs-snapshot-form__input"
                 id="snapshot-player"
                 name="snapshot_player"
                 placeholder="e.g. Zezima"
                 required
                 autocomplete="off">
        </div>
        <div class="osrs-snapshot-form__field">
          <label class="osrs-snapshot-form__label" for="snapshot-mode">Mode</label>
          <select class="osrs-snapshot-form__select" id="snapshot-mode" name="snapshot_mode">
            <option value="auto">Auto Detect</option>
            <option value="main">Main</option>
            <option value="ironman">Ironman</option>
            <option value="hardcore">Hardcore Ironman</option>
            <option value="ultimate">Ultimate Ironman</option>
            <option value="deadman">Deadman</option>
            <option value="tournament">Tournament</option>
            <option value="seasonal">Seasonal</option>
          </select>
        </div>
        <div class="osrs-snapshot-form__field">
          <label class="osrs-snapshot-form__label">&nbsp;</label>
          <button type="submit" class="btn btn-primary">Run Snapshot</button>
        </div>
      </form>
      <div id="snapshot-run-status" class="osrs-text-muted" style="margin-top: var(--space-2); font-size: var(--text-sm);"></div>
      <div id="snapshot-run-results"></div>
    </div>
  </div>

  {# =========================================================================
     4. RECENT SNAPSHOTS -- compact table
     ========================================================================= #}
  <div class="osrs-card">
    <div class="osrs-card__header">
      <h3 class="osrs-card__header-title">Recent Snapshots</h3>
      <button class="btn btn-ghost btn-sm" id="btn-refresh-snapshots" type="button">Refresh</button>
    </div>
    <div class="osrs-card__body">
      <div id="recent-snapshots-loading" class="osrs-loading">
        <div class="osrs-loading__spinner"></div>
        <div class="osrs-loading__text">Loading snapshots...</div>
      </div>
      <div id="recent-snapshots-empty" class="osrs-empty osrs-hidden">
        <div class="osrs-empty__message">No snapshots yet</div>
        <div class="osrs-empty__submessage">Run a snapshot above to get started</div>
      </div>
      <div class="osrs-table-scroll">
      <table class="c-table c-table--striped osrs-hidden" id="recent-snapshots-table">
        <thead>
          <tr>
            <th>Player</th>
            <th>Mode</th>
            <th>Total Level</th>
            <th>Total XP</th>
            <th>Fetched</th>
          </tr>
        </thead>
        <tbody id="recent-snapshots-body"></tbody>
      </table>
      </div>
    </div>
  </div>

  {# =========================================================================
     5. OFFLINE BANNER (hidden by default)
     ========================================================================= #}
  <div id="offline-banner"></div>

  {# =========================================================================
     6. TOAST NOTIFICATION (hidden by default)
     ========================================================================= #}
  <div id="osrs-toast" class="osrs-toast osrs-hidden"></div>

</div>
{% endblock %}

{% block extra_js %}
<script src="/council-static/js/osrs-common.js"></script>
<script src="/council-static/js/osrs-control.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (window.OsrsControl) {
      OsrsControl.init();
    }
  });
</script>
{% endblock %}
