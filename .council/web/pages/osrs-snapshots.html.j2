---
nav_label: Snapshots
nav_order: 3
nav_group: Snapshot Ops
nav_group_order: 1
nav_group_icon: monitor
---
{% extends "base.html" %}

{% block title %}Snapshot Explorer - OSRS{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="/council-static/css/osrs-pages.css">
{% endblock %}

{% block content %}
<div class="osrs-page" id="osrs-snapshots-root">

  <!-- OFFLINE BANNER (hidden by default, shown by JS when backend returns 503) -->
  <div id="snapshots-offline-banner" class="osrs-hidden"></div>

  <!-- PAGE HEADER -->
  <div class="osrs-card">
    <div class="osrs-card__header">
      <h1 class="osrs-card__header-title">Snapshot Explorer</h1>
      <button id="snapshots-refresh-btn" class="btn btn-ghost btn-sm" type="button"
              title="Refresh snapshot list">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 1v5h5M15 15v-5h-5"/>
          <path d="M13.51 6A7 7 0 002.49 10M2.49 10l-1.5 1.5M2.49 6A7 7 0 0113.51 10"/>
        </svg>
        Refresh
      </button>
    </div>
  </div>

  <!-- FILTER BAR -->
  <div class="osrs-card">
    <div class="osrs-card__body">
      <div class="osrs-snapshot-form">
        <div class="osrs-snapshot-form__field osrs-snapshot-form__field--grow">
          <label class="osrs-snapshot-form__label" for="filter-account">Account Name</label>
          <input id="filter-account" class="osrs-snapshot-form__input" type="text"
                 placeholder="e.g. Austin_HCIM">
        </div>
        <div class="osrs-snapshot-form__field">
          <label class="osrs-snapshot-form__label" for="filter-mode">Mode</label>
          <select id="filter-mode" class="osrs-snapshot-form__select">
            <option value="">All Modes</option>
          </select>
        </div>
        <div class="osrs-snapshot-form__field">
          <label class="osrs-snapshot-form__label" for="filter-limit">Limit</label>
          <select id="filter-limit" class="osrs-snapshot-form__select">
            <option value="10">10</option>
            <option value="25" selected>25</option>
            <option value="50">50</option>
            <option value="100">100</option>
          </select>
        </div>
        <div class="osrs-snapshot-form__field">
          <label class="osrs-snapshot-form__label">&nbsp;</label>
          <button id="filter-apply-btn" class="btn btn-primary" type="button">Filter</button>
        </div>
      </div>
    </div>
  </div>

  <!-- RUN SNAPSHOT SECTION -->
  <div class="osrs-card">
    <div class="osrs-card__header">
      <h2 class="osrs-card__header-title">Run Snapshot</h2>
    </div>
    <div class="osrs-card__body">
      <form id="run-snapshot-form" class="osrs-snapshot-form">
        <div class="osrs-snapshot-form__field osrs-snapshot-form__field--grow">
          <label class="osrs-snapshot-form__label" for="run-player">Player Name</label>
          <input id="run-player" class="osrs-snapshot-form__input" type="text"
                 placeholder="e.g. Austin_HCIM" required>
        </div>
        <div class="osrs-snapshot-form__field">
          <label class="osrs-snapshot-form__label" for="run-mode">Mode</label>
          <select id="run-mode" class="osrs-snapshot-form__select">
          </select>
        </div>
        <div class="osrs-snapshot-form__field">
          <label class="osrs-snapshot-form__label">&nbsp;</label>
          <button type="submit" class="btn btn-primary">Run Snapshot</button>
        </div>
      </form>
      <div id="run-snapshot-status" class="osrs-hidden" style="margin-top: var(--space-3);"></div>
    </div>
  </div>

  <!-- LOADING STATE -->
  <div id="snapshots-loading" class="osrs-loading">
    <div class="osrs-loading__spinner"></div>
    <span class="osrs-loading__text">Loading snapshots...</span>
  </div>

  <!-- EMPTY STATE -->
  <div id="snapshots-empty" class="osrs-empty osrs-hidden">
    <svg class="osrs-empty__icon" viewBox="0 0 48 48" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="6" y="6" width="36" height="36" rx="4"/>
      <path d="M16 20h16M16 28h8"/>
    </svg>
    <p class="osrs-empty__message">No snapshots found</p>
    <p class="osrs-empty__submessage">Run a snapshot or adjust your filters to see results.</p>
  </div>

  <!-- SNAPSHOT TABLE -->
  <div id="snapshots-table-wrap" class="osrs-card osrs-hidden">
    <div class="osrs-card__body osrs-card__body--table">
      <table class="c-table c-table--striped c-table--clickable" style="width: 100%;">
        <thead>
          <tr>
            <th>ID</th>
            <th>Account</th>
            <th>Mode</th>
            <th>Total Level</th>
            <th>Total XP</th>
            <th>Fetched At</th>
          </tr>
        </thead>
        <tbody id="snapshots-table-body">
        </tbody>
      </table>
    </div>
  </div>

</div>
{% endblock %}

{% block extra_js %}
<script src="/council-static/js/osrs-common.js"></script>
<script src="/council-static/js/osrs-snapshots.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.OsrsSnapshots) {
      OsrsSnapshots.init();
    }
  });
</script>
{% endblock %}
